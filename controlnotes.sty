% ------------------------------------------------------------- the header ----
% Reproduces the MIT scribe-note masthead of grnotes.sty:
%   <course no. + name (term)>                                          <date>
%   ==========================================================================
%                        Lecture N: <title>
%   ==========================================================================
%   Lecturer: ...                                            Notes: ...
% These notes are one continuous document, so \lecnum and \lecturer are left
% empty; the centred line carries the title of the notes and the range of
% lectures folded into them, and the top line carries course + term.
\newcommand{\ctl@coursehead}{%
  \ifx\ctl@courseno\@empty\else\ctl@courseno\ \fi\ctl@course
  \ifx\ctl@term\@empty\else\ (\ctl@term)\fi}

\newcommand{\ctl@bylineline}{%
  \noindent\begin{minipage}{\textwidth}%
    \normalsize
    \ifx\ctl@lecturer\@empty\else\textit{\ctl@lecturerword:}~\ctl@lecturer\fi
    \hfill
    \ifx\ctl@scribe\@empty\else\textit{\ctl@scribeword:}~\ctl@scribe\fi
  \end{minipage}\\[2pt]}

\newcommand{\makelecheader}{%
  \thispagestyle{plain}%
  \vspace*{-0.40in}%
  \noindent\begin{minipage}{\textwidth}%
    \normalsize\ctl@coursehead\hfill\ctl@date%
  \end{minipage}\\[3pt]
  \noindent\rule{\textwidth}{1.1pt}\\[-9.5pt]
  \noindent\rule{\textwidth}{0.4pt}\\[5pt]
  \noindent\begin{minipage}{\textwidth}\centering
    {\large\bfseries
      \ifx\ctl@lecnum\@empty\else\ctl@lecword\ \ctl@lecnum: \fi\ctl@lectitle}%
  \end{minipage}\\[6pt]
  \noindent\rule{\textwidth}{0.4pt}\\[-9.5pt]
  \noindent\rule{\textwidth}{1.1pt}\\[4pt]
  \ifx\ctl@lecturer\@empty\ifx\ctl@scribe\@empty\else\ctl@bylineline\fi
  \else\ctl@bylineline\fi
  \vspace{1.1em}
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[L]{\small
    \ifx\ctl@lecnum\@empty\else\ctl@lecword\ \ctl@lecnum: \fi\ctl@lectitle}%
  \fancyhead[R]{\small\ctl@date}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
}

% -------------------------------------------------------- theorem-like envs --
% Master counter is `definition', as in grnotes.sty; everything else shares it.
\theoremstyle{definition}
\newtheorem{definition}{\ctl@defword}[section]
\newtheorem{example}[definition]{\ctl@exword}
\newtheorem{exercise}[definition]{\ctl@exerword}
\newtheorem{question}[definition]{\ctl@qword}
\newtheorem{warninner}[definition]{\ctl@cautionword}
\theoremstyle{plain}
\newtheorem{theorem}[definition]{\ctl@thmword}
\newtheorem{lemma}[definition]{\ctl@lemword}
\newtheorem{proposition}[definition]{\ctl@propword}
\newtheorem{corollary}[definition]{\ctl@corword}
\theoremstyle{remark}
\newtheorem{remark}[definition]{\ctl@remword}
\newtheorem{note}[definition]{\ctl@noteword}
\renewcommand{\proofname}{\ctl@proofword}

% ------------------------------------------------------------- boxed notes --
% Both boxes are black-on-white and are told apart by their RULES, not colour:
%   caution/warning -- a heavy rule down the left margin, nothing else;
%   keybox          -- a thin closed frame.
% (The old tcolorbox `warnbox' had a black!4 wash behind it; the wash is gone.)

\newmdenv[
  topline=false,bottomline=false,rightline=false,
  linecolor=black,linewidth=1.8pt,
  backgroundcolor=white,
  innertopmargin=4pt,innerbottommargin=4pt,
  innerleftmargin=9pt,innerrightmargin=0pt,
  skipabove=10pt,skipbelow=10pt
]{ctl@cautionbox}

% \begin{caution}[subject] ... -- unnumbered, byte-for-byte the grnotes one.
\newenvironment{caution}[1][]{%
  \begin{ctl@cautionbox}\noindent{\bfseries\ctl@cautionword%
  \if\relax\detokenize{#1}\relax\else\ (#1)\fi.}\ \ignorespaces
}{\end{ctl@cautionbox}}

% \begin{warning}[subject] ... -- the same box, but NUMBERED.  grnotes' caution
% carries no number; here Appendix A cross-references six of the eight boxes by
% \ref, so the counter has to stay.  Same rule, same spacing, no background.
\NewDocumentEnvironment{warning}{o}
  {\begin{ctl@cautionbox}%
     \IfValueTF{#1}{\begin{warninner}[#1]}{\begin{warninner}}}
  {\end{warninner}\end{ctl@cautionbox}}

\newmdenv[
  linecolor=black,linewidth=0.6pt,
  backgroundcolor=white,
  innertopmargin=7pt,innerbottommargin=7pt,
  innerleftmargin=9pt,innerrightmargin=9pt,
  skipabove=10pt,skipbelow=10pt
]{keybox}

% ---------------------------------------------------------------- appendices -
% \notesappendix is \appendix plus the one thing \appendix does not do: it puts
% the word Appendix/부록 in front of the letter in the printed heading.  The ToC
% entry keeps the bare letter, because article's \l@section only reserves 1.5em
% for the number.  The sections stay real \section's, so they are numbered,
% land in the ToC, and get a numbered PDF bookmark.
\newcommand{\notesappendix}{%
  \appendix
  \titleformat{\section}{\normalfont\large\bfseries}%
    {\appendixname~\thesection}{0.7em}{}%
}

