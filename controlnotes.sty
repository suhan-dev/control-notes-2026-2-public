%% ---------------------------------------------------------------------------
%%  controlnotes.sty  --  MIT-scribe style lecture notes
%%  Introduction to Control Engineering, 2026 Fall
%%
%%  Usage:  \usepackage{controlnotes}            % English
%%          \usepackage[korean]{controlnotes}    % Korean
%%
%%  BOTH editions are compiled with XeLaTeX.  The two .tex files used to carry
%%  a duplicated preamble each -- one built for pdflatex, one for xelatex --
%%  which is how they drifted apart; everything shared now lives here.
%%
%%  Layout, headings, boxes and macros follow grnotes.sty (General Relativity,
%%  2026 Fall), which is the house standard.  Only the block-diagram TikZ
%%  styles and the four course macros at the bottom are proper to control
%%  engineering.
%%
%%  Monochrome by design: everything prints black on white.
%% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{controlnotes}[2026/09/19 v1.0 Control lecture-note style]

\newif\ifctl@korean \ctl@koreanfalse
\DeclareOption{korean}{\ctl@koreantrue}
\DeclareOption{english}{\ctl@koreanfalse}
\ProcessOptions\relax

% ------------------------------------------------------------------ layout --
\RequirePackage[letterpaper,margin=1in,headheight=15pt,headsep=18pt]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{bm}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{mdframed}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,
                decorations.pathreplacing,decorations.pathmorphing,patterns}
\RequirePackage{cancel}
\RequirePackage{microtype}

% ------------------------------------------------------------------- fonts --
\RequirePackage{fontspec}
% fontspec's own default (Latin Modern, shipped with TeX Live) is used for the
% Latin script -- no \setmainfont needed, and it avoids depending on the fonts
% being registered with the OS font manager.

\ifctl@korean
  \RequirePackage[hangul]{xetexko}
  \setmainhangulfont{Nanum Myeongjo}[Script=Hangul,AutoFakeSlant=0.2]
  \setsanshangulfont{Nanum Gothic}[Script=Hangul]
  \setmonohangulfont{Nanum Gothic}[Script=Hangul]
\fi

% Links stay black: these notes are meant to be read and printed on paper.
% bookmarksnumbered: article writes its ToC entries as \numberline{1}{...}, and
% hyperref drops that number from the bookmark unless asked to keep it.  The web
% viewer keys on the section number to carry your place across the EN/KO switch
% (the two editions have different page counts, the numbering is the same), so
% the bookmarks have to read "5.3 Poles, zeros, and properness", not just the
% title.
\RequirePackage[colorlinks=true,linkcolor=black,citecolor=black,
                urlcolor=black,filecolor=black,
                bookmarksnumbered=true]{hyperref}

% ----------------------------------------------------------- course fields --
% Same field set and the same names as grnotes.sty.  Nothing here had to be
% renamed: this course's own macros are \R, \Lap, \tp and \Dop, so \scribe,
% \term, \lecturer and the rest were all free.
\let\ctl@course\@empty   \let\ctl@courseno\@empty \let\ctl@term\@empty
\let\ctl@lecnum\@empty   \let\ctl@lectitle\@empty \let\ctl@date\@empty
\let\ctl@lecturer\@empty \let\ctl@scribe\@empty

\newcommand{\coursename}[1]{\def\ctl@course{#1}}
\newcommand{\courseno}[1]{\def\ctl@courseno{#1}}
\newcommand{\term}[1]{\def\ctl@term{#1}}
\newcommand{\lecnum}[1]{\def\ctl@lecnum{#1}}
\newcommand{\lectitle}[1]{\def\ctl@lectitle{#1}}
\newcommand{\lecdate}[1]{\def\ctl@date{#1}}
\newcommand{\lecturer}[1]{\def\ctl@lecturer{#1}}
\newcommand{\scribe}[1]{\def\ctl@scribe{#1}}

