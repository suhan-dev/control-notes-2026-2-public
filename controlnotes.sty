\setlength{\parindent}{0pt}
\emergencystretch=2em
% -------------------------------------------------- part and lecture marks ---
% Two structural marks, shared by both editions.
%
% \partdivider{<full title>} opens a Part: a fresh page carrying the title
% between two hairlines, e.g.
%       \partdivider{Part I --- Feedback and Modelling}
%       \partdivider{제1부 --- 되먹임과 모델링}
% Section numbering is NOT reset by it.  The Parts are a reading order laid
% over one continuous run of sections 1, 2, 3, ....
%
% The ToC line is written at `part' level, not at `section' level, so that
% hyperref places the Part bookmark one step ABOVE the section bookmarks and
% the sections nest underneath it.  The Part bookmark carries no \numberline,
% hence no number, and that is deliberate: the web viewer takes a NUMBERED
% bookmark to be a section (it keys on the section number to carry the
% reader's place across the EN/KO switch), so a numbered Part bookmark would
% be mistaken for a section.
%
% ------------------------------------------------ 목차의 대단원 줄 (\l@part) --
% 여섯 과목 노트가 모두 이 모양을 쓴다. 목차에서 대단원이 어디서 바뀌는지 한눈에
% 보이게 하는 것이 목적이다: 위에 넉넉한 여백, 본문 폭을 가로지르는 가는 회색 선
% (이 노트가 다른 데서 쓰는 선과 같은 0.4pt, 같은 계열의 회색), 그 아래 한 칸 키워
% 굵게 세운 제목. 쪽 번호는 절 줄과 같은 자리·같은 크기다 — 제목의 \large 를
% 물려받지 않도록 글자 크기를 바꾸기 전에 상자에 담아 둔다.
% (로마자를 작은 대문자로 세워 보았으나 이 노트가 쓰는 Latin Modern 에는 굵은
%  작은 대문자 면이 없다. \scshape\bfseries 는 로그에 TU/lmr/bx/sc undefined 를
%  남기고 조용히 굵은 정체로 대체되어, 화면에는 소문자가 그대로 찍힌다. 한글
%  글꼴에는 애초에 작은 대문자가 없다 — 그래서 두 판 모두 크기와 굵기로만
%  드러낸다. 그래야 EN/KO 가 같은 모양이 된다.)
% 쪽이 끝나는 자리에서 대단원 줄만 홀로 남지 않게: 줄 앞은 넘기기 좋은 자리로
% 표시하고(\addpenalty{-\@highpenalty}), 선과 제목 사이·제목 뒤는 끊기지 못하게
% 막는다(\nobreak, \penalty\@M, \@nobreaktrue — 마지막 것이 있어야 뒤따르는
% \l@section 의 \addpenalty 가 그 자리에 끊을 틈을 도로 내지 않는다).
% 절·소절 줄은 건드리지 않는다.
\renewcommand*\l@part[2]{%
  \ifnum\c@tocdepth>-2\relax
    \addpenalty{-\@highpenalty}%
    \addvspace{0.9em \@plus\p@}%
    \begingroup
      \parindent\z@ \parfillskip\z@skip \rightskip\z@skip
      \sbox\z@{#2}%                    % 쪽번호를 목차 본래 크기로 미리 담아 둔다
      {\color[gray]{0.55}\hrule height0.4pt depth\z@}%
      \nobreak\vskip 0.4em
      \rightskip\@pnumwidth \parfillskip-\@pnumwidth
      \leavevmode\large\bfseries
      #1\nobreak\hfil\nobreak\hb@xt@\@pnumwidth{\hss\usebox\z@}\par
      \penalty\@M\vskip 0.25em
    \endgroup
    \@nobreaktrue
  \fi}

\newcommand{\partdivider}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{part}{#1}%
  \vspace*{0.10\textheight}
  \begin{center}
    \rule{0.62\textwidth}{0.4pt}\\[13pt]
    {\Large\scshape #1}\\[13pt]
    \rule{0.62\textwidth}{0.4pt}
  \end{center}
  \vspace{0.045\textheight}
  \par\noindent\ignorespaces}

% \lecturebreak{<lecture>}{<date>} marks the point at which one lecture's new
% material begins: a hairline across the measure with the label set flush
% right, e.g.
%       \lecturebreak{Lecture 2}{7 September 2026}
%       \lecturebreak{제2강}{2026년 9월 7일}
% It goes into neither the ToC nor the bookmarks -- it is a mark in a
% topic-ordered document, not a division of it.  This is a monochrome course,
% so the two greys below stand in for the colours the QFT notes use.
% \widthof is not expandable inside \dimexpr (a hard error, not a warning), so
% the label is measured into a scratch length with \settowidth first.
\definecolor{ctlrule}{gray}{0.6}
\definecolor{ctlmark}{gray}{0.35}
\newlength{\ctl@lbwidth}
\newcommand{\lecturebreak}[2]{%
  \par\addvspace{14pt}%
  \settowidth{\ctl@lbwidth}{\footnotesize\textsc{#1 \textperiodcentered\ #2}}%
  \noindent\hbox to \textwidth{%
    {\color{ctlrule}\vrule height0.4pt depth0pt
       width\dimexpr\textwidth-\ctl@lbwidth-8pt\relax}%
    \hfill
    {\color{ctlmark}\footnotesize\textsc{#1 \textperiodcentered\ #2}}}%
  \par\addvspace{9pt}\noindent\ignorespaces}

\endinput
