% ------------------------------------------------------------ figure styles --
% Block diagrams.  Course-specific and deliberately unchanged.
\tikzset{
  blk/.style  = {draw,rounded corners=1pt,align=center,inner sep=5pt,
                 minimum height=11mm,minimum width=26mm},
  sumc/.style = {draw,circle,minimum size=5.5mm,inner sep=0pt},
  sig/.style  = {font=\small},
  lbl/.style  = {font=\footnotesize},
}
% caption formatting without pulling in the caption package
\long\def\@makecaption#1#2{%
  \vskip 6pt
  \small
  \sbox\@tempboxa{\textbf{#1.} #2}%
  \ifdim\wd\@tempboxa>\hsize
    \textbf{#1.} #2\par
  \else
    \global\@minipagefalse
    \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip 2pt}

% section headings a little tighter, MIT-notes-like
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.5ex plus 1ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.2ex plus 1ex minus .2ex}{0.8ex plus .2ex}

